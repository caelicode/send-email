{
  "name": "@caelicode/send-email",
  "version": "1.0.0",
  "description": "GitHub Action to send emails via any SMTP server",
  "type": "module",
  "main": "sendemail.js",
  "scripts": {
    "build": "ncc build sendemail.js -o dist --license licenses.txt",
    "release": "npm version patch && npm run build && git add -A && git commit -m 'build: compile dist' && git push --follow-tags"
  },
  "author": "caelicode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caelicode/send-email.git"
  },
  "keywords": [
    "github-action",
    "email",
    "smtp",
    "nodemailer"
  ],
  "bugs": {
    "url": "https://github.com/caelicode/send-email/issues"
  },
  "homepage": "https://github.com/caelicode/send-email#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "nodemailer": "^9.0.0"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1"
  }
}
